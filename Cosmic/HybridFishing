--========================== DEPENDENCIES ========================--

import("System.Numerics")

--=========================== VARIABLES ==========================--

-------------------
--    General    --
-------------------

MissionName   = "EX: Refined Moon Gel"
Coords        = "/coord 15.8 19.4"
Preset        = "AH4_"
ItemId        = 45922
ItemAmount    = 2
SuccessCount  = 0
LogPrefix     = "[HybridFishing]"

--============================ CONSTANT ==========================--

-----------------
--    Zones    --
-----------------

Zones = {
    SinusArdorum = 1237,
    Phaenna      = 1291
}

--=========================== FUNCTIONS ==========================--

-------------------
--    Utility    --
-------------------

function Wait(time)
    yield(string.format("/wait %g", time))
end

function Log(message)
    Dalamud.Log(string.format("%s %s", LogPrefix, message))
end

function Echo(message)
    yield(string.format("/echo %s %s", LogPrefix, message))
end

--------------------------
--    Initialization    --
--------------------------

function Init()
    if Player.Job and Player.Job.Id ~= 18 then
        Echo("Wrong class.. Trying to switch.")
        Log("Wrong class.. Trying to switch.")
        yield("/gs change Fisher")
        Wait(2)
        if Player.Job and Player.Job.Id ~= 18 then
            Echo("Wrong class.. Aborting.")
            Log("Wrong class.. Aborting.")
            return false
        end
        Echo("Switched to Fisher.")
        Log("Switched to Fisher.")
    end

    if not Player.Gearset or not Player.Gearset.Name or Player.Gearset.Name == "" then
        Echo("Fisher gearset not detected.. Aborting.")
        Log("Fisher gearset not detected.. Aborting.")
        return false
    end

    Wait(0.1)
    Class = Player.Gearset.Name
    return true
end

function WaitForPlayer()
    Log("Waiting For Player...")
    while not Player.Available or Player.IsBusy do
        Wait(0.1)
    end
    Wait(1)
end

----------------------
--    Navigation    --
----------------------

function WaitForZoneChange()
    repeat
        Wait(0.1)
    until Svc.Condition[45]
    Wait(1)
    repeat
        Wait(0.1)
    until not Svc.Condition[45]
    Wait(1)
end

function WaitForVnavMesh()
    repeat
        Wait(0.1)
    until not IPC.vnavmesh.PathfindInProgress() and not IPC.vnavmesh.IsRunning()
    Wait(0.1)
end

function MoveToSpot()
    if Svc.ClientState.TerritoryType == Zones.SinusArdorum then
        Log(string.format("Heading to %s", MissionName))
        yield(Coords)
        Wait(0.1)
        IPC.vnavmesh.PathfindAndMoveTo(Vector3(-264.005, 22.156, -94.770), false)
        WaitForVnavMesh()
    else
        Echo("Stopping Script.. Move to Sinus Ardorum, then start the script..")
        Log("Stopping Script.. Move to Sinus Ardorum, then start the script..")
        yield("/snd stop all")
    end
end

-------------------
--    Fishing    --
-------------------

function WaitForFishingItem(maxWaitSeconds)
    local waitElapsed = 0
    local retryCount  = 0
    local maxRetries  = 3

    IPC.AutoHook.CreateAndSelectAnonymousPreset(Preset)
    IPC.AutoHook.SetPluginState(true)
    Wait(1)

    while not Svc.Condition[43] and retryCount < maxRetries do
        retryCount = retryCount + 1
        Log("Attempting to start fishing (retry " .. retryCount .. ")")
        yield("/ahstart")
        Wait(5)
    end

    if not Svc.Condition[43] then
        Echo("Failed to start fishing after retries.")
        Log("Fishing did not start after retries.")
        return false
    end

    Log("Waiting to obtain item ID " .. ItemId .. " x" .. ItemAmount)
    while Inventory.GetItemCount(ItemId) < ItemAmount and waitElapsed < maxWaitSeconds do
        Wait(1)
        waitElapsed = waitElapsed + 1
    end

    if Inventory.GetItemCount(ItemId) < ItemAmount then
        IPC.AutoHook.SetPluginState(false)
        Wait(1)
        while Svc.Condition[6] do
            yield("/ac Quit")
            Wait(0.1)
        end
        Echo("Timeout waiting for item ID " .. ItemId)
        Log("Timeout acquiring item ID " .. ItemId)
        return false
    end

    if Svc.Condition[43] then
        Log("Still in fishing mode, waiting to exit.")
        Wait(1)
        while Svc.Condition[43] do
            Wait(0.1)
        end
    end

    if Svc.Condition[6] then
        Log("Still in gathering mode, waiting to exit.")
        Wait(1)
        while Svc.Condition[6] do
            yield("/ac Quit")
            Wait(0.1)
        end
    end

    IPC.AutoHook.DeleteAllAnonymousPresets()
    IPC.AutoHook.SetPluginState(false)
    Log("Successfully acquired required items.")
    return true
end

--------------------
--    Crafting    --
--------------------

function StartCrafting()
    if not Addons.GetAddon("WKSRecipeNotebook").Ready then
        if not Addons.GetAddon("WKSMissionInfomation").Ready then
            yield("/callback WKSHud true 11")
            Wait(0.2)
        end

        if not Addons.GetAddon("WKSRecipeNotebook").Ready then
            yield("/callback WKSMissionInfomation true 14 1")
        end
    end

    Wait(0.5)
    Log("Crafting..")
    IPC.Artisan.SetEnduranceStatus(true)
    Wait(10)

    while IPC.Artisan.GetEnduranceStatus() == true do
        Wait(0.5)
    end

    Log("Crafting completed successfully.")
    Wait(1)
end

---------------------
--    Reporting    --
---------------------

function SubmitReport()
    Log("Reporting the Mission..")
    if not Addons.GetAddon("WKSMissionInfomation").Ready then
        yield("/callback WKSHud true 11")
        Wait(0.2)
    end

    if Addons.GetAddon("WKSRecipeNotebook").Ready then
        yield("/callback WKSMissionInfomation true 14 1")
    end

    while Svc.Condition[5] do
        Wait(0.1)
    end

    Wait(1)
    Log("Changing Gearset to " .. Class)
    yield("/gs change " .. Class)
    Wait(1)
    yield("/callback WKSMissionInfomation true 11 1")
    Wait(1)
end

-------------------
--    Repairs    --
-------------------

function RepairIfNeeded(RepairCount)
    if SuccessCount == 0 or SuccessCount % RepairCount ~= 0 then
        return
    end

    Wait(2)
    Log("Attempting to repair gear...")

    while not Addons.GetAddon("Repair").Ready do
        yield("/generalaction repair")
        Wait(0.5)
    end

    yield("/callback Repair true 0")
    Wait(0.1)

    if Addons.GetAddon("SelectYesno").Ready then
        yield("/callback SelectYesno true 0")
        Wait(0.1)
    end

    while Svc.Condition[39] do
        Wait(1)
    end

    Wait(1)
    yield("/callback Repair true -1")
    Wait(2)
    Log("Repair complete.")
end

--=========================== EXECUTION ==========================--

if Init() then
    Log("MissionName: " .. MissionName)
    Log("MissionCoords: " .. Coords)
    Log("MissionPreset: " .. Preset)
else
    return
end

while true do
    if SuccessCount == 0 then
        MoveToSpot()
    elseif SuccessCount == 5 then
        IPC.vnavmesh.PathfindAndMoveTo(Vector3(-259.450, 22.337, -75.942), false)
        WaitForVnavMesh()
    elseif SuccessCount == 10 then
        IPC.vnavmesh.PathfindAndMoveTo(Vector3(-297.165, 22.075, -91.238), false)
        WaitForVnavMesh()
    end

    if Svc.Condition[4] then
        local dismountActionId = 23
        Log("Dismounting...")
        repeat
            Actions.ExecuteGeneralAction(dismountActionId)
            Wait(1)
        until not Svc.Condition[4]
        WaitForPlayer()
    end

    yield("/ice start")
    local currentMissionName = ""
    while (currentMissionName ~= MissionName) do
        Wait(1)
        if Addons.GetAddon("WKSMissionInfomation").Ready then
            currentMissionName = Addons.GetAddon("WKSMissionInfomation"):GetNode(1,3).Text
        elseif not Addons.GetAddon("WKSMissionInfomation").Ready and not Addons.GetAddon("WKSMission").Ready then
            yield("/callback WKSHud true 11")
            Wait(1)
        end
    end

    Wait(1)
    if not WaitForFishingItem(500) then
        Echo("Fishing failed. Proceeding to submit report only.")
        Log("Fishing step failed or timed out.")
        WaitForPlayer()
        SubmitReport()
        SuccessCount = 0
    elseif Inventory.GetItemCount(ItemId) >= ItemAmount then
        Log("Sufficient mats for crafting..")
        WaitForPlayer()
        StartCrafting()
        SubmitReport()
        SuccessCount = SuccessCount + 1
        Echo("SuccessCount: " .. SuccessCount)
        Log("SuccessCount: " .. SuccessCount)
    end

    WaitForPlayer()
    RepairIfNeeded(15)

    if SuccessCount == 15 then
        SuccessCount = 0
    end
end

